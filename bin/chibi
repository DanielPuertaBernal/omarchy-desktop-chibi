#!/usr/bin/env bash
# Toggle the desktop chibi (Omarchy plugin danso.chibi).
# Usage: chibi [on|off|toggle|status|sleep|wake]   (default: toggle)
#   sleep  keep her asleep until `chibi wake`
#   wake   let her roam again
set -euo pipefail

ID="danso.chibi"
STATE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/danso-chibi/state"

# The plugin watches this file (see stateFile in Service.qml).
set_state() {
  mkdir -p "$(dirname "$STATE")"
  echo "$1" >"$STATE"
}

is_enabled() {
  omarchy plugin list | awk -v id="$ID" '$1 == id { print $2 }' | grep -qx enabled
}

case "${1:-toggle}" in
  on) omarchy plugin enable "$ID" ;;
  off) omarchy plugin disable "$ID" ;;
  toggle)
    if is_enabled; then omarchy plugin disable "$ID"; else omarchy plugin enable "$ID"; fi
    ;;
  status)
    if is_enabled; then echo "on"; else echo "off"; fi
    ;;
  sleep) set_state sleep ;;
  wake) set_state awake ;;
  *)
    echo "Usage: chibi [on|off|toggle|status|sleep|wake]" >&2
    exit 1
    ;;
esac
